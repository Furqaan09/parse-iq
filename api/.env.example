# Copy this file to .env and fill in real values

# PostgreSQL connection (Compose overrides this to point at its db service)
DATABASE_URL=postgresql+psycopg://parseiq:change_me@localhost:5433/parseiq

# Hugging Face Inference Providers (used for the RAG chat LLM)
HF_TOKEN=hf_your_token_here
HF_LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-1M
HF_LLM_PROVIDER=auto
