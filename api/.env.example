# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=parseiq
DB_USER=parseiq
DB_PASSWORD=change_me

# Hugging Face Inference Providers (used for the RAG chat LLM)
HF_TOKEN=hf_your_token_here
HF_LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-1M
HF_LLM_PROVIDER=auto
