# Copy this file to .env and fill in real values

# PostgreSQL connection (Compose overrides this to point at its db service)
DATABASE_URL=postgresql+psycopg://parseiq:change_me@localhost:5433/parseiq

# OpenAI (embeddings and LLM)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-5.6-luna

# AWS
STORAGE_BACKEND=local  # local (dev, tests) | s3 (deployed)
S3_BUCKET=
AWS_REGION=us-east-1
# The app's IAM user
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_TOPIC_ARN=