# Copy this file to .env and fill in real values

# PostgreSQL connection (Compose overrides this to point at its db service)
DATABASE_URL=postgresql+psycopg://parseiq:change_me@localhost:5433/parseiq

# OpenAI (embeddings and LLM)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-5.6-luna
